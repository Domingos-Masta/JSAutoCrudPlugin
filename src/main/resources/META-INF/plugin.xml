<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.isysdcore.jsautocrud.SpringAutoCrudClassGenerator</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>JSAutoCrud</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="domingos.m.feranndo@gmail.com" url="https://www.isysdcore.com">Isys-Dcore</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <h2>JSAutoCrud — Spring Boot CRUD generator</h2>
    <p>Generate complete REST layers (entity, repository, service and controller) for Spring Boot 3.x
    applications powered by the <b>generic-auto-crud</b> library.</p>
    <ul>
      <li>SQL (JPA) and MongoDB support</li>
      <li>DTO layer generation with mapper</li>
      <li>Integration test generation</li>
      <li>Entity associations (JPA) for SQL entities</li>
      <li>Generate from scratch or from existing entities</li>
    </ul>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Add the necessary dependency -->
    <depends>com.intellij.modules.java</depends>
<!--    <depends>com.intellij.modules.clion</depends>-->
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

    </extensions>
    <!-- Declare the actions (for example, a menu action to generate classes) -->
    <actions>
        <group id="AutoCrudResourceGroup" text="AutoCRUD Resource" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <action id="AutoCrud.FromScratch" class="com.isysdcore.jsautocrud.GenerateFromScratchAction"
                    text="From Scratch" icon="AllIcons.Actions.New"
                    description="Generate entity, repository, service and controller from scratch"/>
            <action id="AutoCrud.FromModel" class="com.isysdcore.jsautocrud.GenerateFromModelAction"
                    text="From Existing Entity" icon="AllIcons.Nodes.Class"
                    description="Generate layers for an entity that already exists in the project"/>
            <separator/>
            <action id="AutoCrud.OnlyRepositories" class="com.isysdcore.jsautocrud.GenerateRepositoriesAction"
                    text="Repositories Only" icon="AllIcons.Nodes.DataTables"
                    description="Generate only repositories for existing entities"/>
            <action id="AutoCrud.OnlyServices" class="com.isysdcore.jsautocrud.GenerateServicesAction"
                    text="Services Only" icon="AllIcons.Nodes.Function"
                    description="Generate only services for existing entities"/>
            <action id="AutoCrud.OnlyControllers" class="com.isysdcore.jsautocrud.GenerateControllersAction"
                    text="Controllers Only" icon="AllIcons.Nodes.Controller"
                    description="Generate only controllers for existing entities"/>
        </group>
    </actions>
</idea-plugin>